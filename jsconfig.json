{
    "compilerOptions": {
        "composite": true,
        "types": [
            "vite/client"
        ],
        "sourceMap": true,
        "module": "ESNext",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "node",
        "target": "ESNext",
        "jsx": "preserve",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
} 